let
    Source =
        Oracle.Database(
            "dsvldforddb06.dover-global.net:1521/biprod.dover-global.net",
            [
                HierarchicalNavigation = true,
                CreateNavigationProperties = false
            ]
        ),

    PROD_DW_HYDRO =
        Source{[Schema = "PROD_DW_HYDRO"]}[Data],

    T_SALES_ORDER_LINE_ITEMS_F =
        PROD_DW_HYDRO{[Name = "T_SALES_ORDER_LINE_ITEMS_F"]}[Data],

   CurrentDateTime =
        DateTime.LocalNow(),

    CurrentDate =
        Date.From(CurrentDateTime),

    AnalysisStartDate =
        Date.AddYears(
            CurrentDate,
            -2
        ),

    #"Last 2 Years" =
        Table.SelectRows(
            T_SALES_ORDER_LINE_ITEMS_F,
            each
                Date.From([BOOKED_DATE]) >= AnalysisStartDate
                and Date.From([BOOKED_DATE]) <= CurrentDate
        ),
		
    #"Hyd Org Key And Order" =
        Table.SelectRows(
            #"Last 2 Years",
            each
                [ORGANIZATION_SKEY] = 1004
                and [TRANSACTION_TYPE] = "ORDER"
                and [ITEM_SKEY] <> null
        ),
    #"Merged Queries" = Table.NestedJoin(#"Hyd Org Key And Order", {"BILL_TO_CUST_BUS_PURPOSE_SKEY"}, #"Customer Business Purpose", {"CUSTOMER_BUSINESS_PURPOSE_SKEY"}, "Customer Business Purpose", JoinKind.LeftOuter),
    #"Expanded Customer Business Purpose" = Table.ExpandTableColumn(#"Merged Queries", "Customer Business Purpose", {"CUSTOMER_CLASSIFICATION"}, {"Customer Business Purpose.CUSTOMER_CLASSIFICATION"}),
      
      #"Filter OUT Intercompany" =
        Table.SelectRows(
            #"Expanded Customer Business Purpose",
            each
                [Customer Business Purpose.CUSTOMER_CLASSIFICATION]
                    <> "INTERCOMPANY"
        ),

    // Add the calendar quarter number
    AddedQuarterNumber =
        Table.AddColumn(
            #"Filter OUT Intercompany",
            "Quarter Number",
            each Date.QuarterOfYear(Date.From([BOOKED_DATE])),
            Int64.Type
        ),

  // Use TOTAL_ORDERED_QUANTITY as the demand field.
    // Return 0 when there are no orders in the selected period.
    SumDemand =
        (InputTable as table) as number =>
            let
                Quantities =
                    List.Transform(
                        List.RemoveNulls(
                            Table.Column(
                                InputTable,
                                "TOTAL_ORDERED_QUANTITY"
                            )
                        ),
                        each Number.From(_)
                    ),

                TotalDemand =
                    List.Sum(Quantities)
            in
                if TotalDemand = null then
                    0
                else
                    TotalDemand,

    // Use the latest booking date for the rolling 12-month calculations
    LatestBookingDate =
        Date.From(
            List.Max(
                List.RemoveNulls(
                    Table.Column(
                        AddedQuarterNumber,
                        "BOOKED_DATE"
                    )
                )
            )
        ),

    // Calculate average demand for a specific quarter
    // across the two-year analysis period
    AverageDemandByQuarter =
        (
            InputTable as table,
            QuarterNumber as number
        ) as number =>
            let
                QuarterDemand =
                    SumDemand(
                        Table.SelectRows(
                            InputTable,
                            each
                                [Quarter Number] = QuarterNumber
                                and Date.From([BOOKED_DATE]) >= AnalysisStartDate
                                and Date.From([BOOKED_DATE]) <= CurrentDate
                        )
                    ),

                AverageDemand =
                    QuarterDemand / 2
            in
                AverageDemand,
				


    TotalAnalysisDays =
        Duration.Days(
            CurrentDate - AnalysisStartDate
        ) + 1,

    // Group the source data by item
    GroupedByItem =
        Table.Group(
            AddedQuarterNumber,
            {"ITEM_SKEY"},
            {
                {
                    "ItemRows",
                    each _,
                    type table
                }
            }
        ),

    // Total demand by item
    AddedTotalDemand =
        Table.AddColumn(
            GroupedByItem,
            "Total Demand",
            each SumDemand([ItemRows]),
            type number
        ),

    // Average weekly demand by item
    AddedAverageWeeklyDemand =
        Table.AddColumn(
            AddedTotalDemand,
            "Average Weekly Demand",
            each
                [Total Demand] / (TotalAnalysisDays / 7),
            type number
        ),

    // Average monthly demand by item
    AddedAverageMonthlyDemand =
        Table.AddColumn(
            AddedAverageWeeklyDemand,
            "Average Monthly Demand",
            each
                [Total Demand] / (TotalAnalysisDays / 30.4375),
            type number
        ),

    // Average Q1 demand by item
    AddedQ1AverageDemand =
        Table.AddColumn(
            AddedAverageMonthlyDemand,
            "Q1 Average Demand",
            each
                AverageDemandByQuarter(
                    [ItemRows],
                    1
                ),
            type number
        ),

    // Average Q2 demand by item
    AddedQ2AverageDemand =
        Table.AddColumn(
            AddedQ1AverageDemand,
            "Q2 Average Demand",
            each
                AverageDemandByQuarter(
                    [ItemRows],
                    2
                ),
            type number
        ),

    // Average Q3 demand by item
    AddedQ3AverageDemand =
        Table.AddColumn(
            AddedQ2AverageDemand,
            "Q3 Average Demand",
            each
                AverageDemandByQuarter(
                    [ItemRows],
                    3
                ),
            type number
        ),

    // Average Q4 demand by item
    AddedQ4AverageDemand =
        Table.AddColumn(
            AddedQ3AverageDemand,
            "Q4 Average Demand",
            each
                AverageDemandByQuarter(
                    [ItemRows],
                    4
                ),
            type number
        ),

    // Overall average quarterly demand across Q1 through Q4
    AddedAverageQuarterlyDemand =
        Table.AddColumn(
            AddedQ4AverageDemand,
            "Average Quarterly Demand",
            each
                List.Average(
                    {
                        [Q1 Average Demand],
                        [Q2 Average Demand],
                        [Q3 Average Demand],
                        [Q4 Average Demand]
                    }
                ),
            type number
        ),


    // Current rolling 12-month period
    Current12MonthStart =
        Date.AddDays(
            LatestBookingDate,
            -365
        ),

    // Previous rolling 12-month period
    Previous12MonthStart =
        Date.AddDays(
            LatestBookingDate,
            -730
        ),

    // Current rolling 12-month demand by item
    AddedCurrent12MonthDemand =
        Table.AddColumn(
            AddedAverageQuarterlyDemand,
            "Current 12-Month Demand",
            each
                SumDemand(
                    Table.SelectRows(
                        [ItemRows],
                        (CurrentRow) =>
                            Date.From(CurrentRow[BOOKED_DATE]) > Current12MonthStart
                            and Date.From(CurrentRow[BOOKED_DATE]) <= LatestBookingDate
                    )
                ),
            type number
        ),

    // Previous rolling 12-month demand by item
    AddedPrevious12MonthDemand =
        Table.AddColumn(
            AddedCurrent12MonthDemand,
            "Previous 12-Month Demand",
            each
                SumDemand(
                    Table.SelectRows(
                        [ItemRows],
                        (PreviousRow) =>
                            Date.From(PreviousRow[BOOKED_DATE]) > Previous12MonthStart
                            and Date.From(PreviousRow[BOOKED_DATE]) <= Current12MonthStart
                    )
                ),
            type number
        ),

    // Rolling 12-month growth rate by item
    AddedRollingGrowthRate =
        Table.AddColumn(
            AddedPrevious12MonthDemand,
            "Rolling 12-Month Growth Rate",
            each
                if [#"Previous 12-Month Demand"] = 0 then
                    null
                else
                    (
                        [#"Current 12-Month Demand"]
                        / [#"Previous 12-Month Demand"]
                    ) - 1,
            type number
        ),

    // Flag growth rates with an increase or decrease greater than 25%
    AddedGrowthRateFlag =
        Table.AddColumn(
            AddedRollingGrowthRate,
            "Growth Rate Greater Than 25% Change",
            each
                if [#"Rolling 12-Month Growth Rate"] <> null
                    and Number.Abs([#"Rolling 12-Month Growth Rate"]) > 0.25
                then
                    "Yes"
                else
                    "No",
            type text
        ),
        
  // Forecast function.
    // If the calculated forecast is 0, use the corresponding average demand instead.
    ForecastDemand =
        (
            AverageDemand as nullable number,
            GrowthRate as nullable number
        ) as nullable number =>
            let
                CalculatedForecast =
                    if AverageDemand = null or GrowthRate = null then
                        null
                    else
                        AverageDemand * (1 + GrowthRate)
            in
                if CalculatedForecast = 0 then
                    AverageDemand
                else
                    CalculatedForecast,
                    
    // Forecast weekly demand
    AddedWeeklyForecast =
        Table.AddColumn(
            AddedGrowthRateFlag,
            "Forecast Weekly Demand - Year 1",
            each
                ForecastDemand(
                    [#"Average Weekly Demand"],
                    [#"Rolling 12-Month Growth Rate"]
                ),
            type number
        ),

    // Forecast monthly demand
    AddedMonthlyForecast =
        Table.AddColumn(
            AddedWeeklyForecast,
            "Forecast Monthly Demand - Year 1",
            each
                ForecastDemand(
                    [#"Average Monthly Demand"],
                    [#"Rolling 12-Month Growth Rate"]
                ),
            type number
        ),

    // Forecast quarterly 1 demand
    AddedQuarterly1Forecast =
        Table.AddColumn(
            AddedMonthlyForecast,
            "Forecast Quarterly 1 Demand - Year 1",
            each
                ForecastDemand(
                    [#"Q1 Average Demand"],
                    [#"Rolling 12-Month Growth Rate"]
                ),
            type number
        ),

    // Forecast quarterly 2 demand
    AddedQuarterly2Forecast =
        Table.AddColumn(
            AddedQuarterly1Forecast,
            "Forecast Quarterly 2 Demand - Year 1",
            each
                ForecastDemand(
                    [#"Q2 Average Demand"],
                    [#"Rolling 12-Month Growth Rate"]
                ),
            type number
        ),

    // Forecast quarterly 3 demand
    AddedQuarterly3Forecast =
        Table.AddColumn(
            AddedQuarterly2Forecast,
            "Forecast Quarterly 3 Demand - Year 1",
            each
                ForecastDemand(
                    [#"Q3 Average Demand"],
                    [#"Rolling 12-Month Growth Rate"]
                ),
            type number
        ),

    // Forecast quarterly 4 demand
    AddedQuarterly4Forecast =
        Table.AddColumn(
            AddedQuarterly3Forecast,
            "Forecast Quarterly 4 Demand - Year 1",
            each
                ForecastDemand(
                    [#"Q4 Average Demand"],
                    [#"Rolling 12-Month Growth Rate"]
                ),
            type number
        ),

    // Forecast quarterly demand
    AddedQuarterlyForecast =
        Table.AddColumn(
            AddedQuarterly4Forecast,
            "Forecast Quarterly Demand - Year 1",
            each
                ForecastDemand(
                    [#"Average Quarterly Demand"],
                    [#"Rolling 12-Month Growth Rate"]
                ),
            type number
        ),

    // Remove the nested detail rows
    RemovedItemRows =
        Table.RemoveColumns(
            AddedQuarterlyForecast,
            {"ItemRows"}
        ),

    // Round demand and forecast values
    RoundedValues =
        Table.TransformColumns(
            RemovedItemRows,
            {
                {
                    "Total Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Average Weekly Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Average Monthly Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Average Quarterly Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Current 12-Month Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Previous 12-Month Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Rolling 12-Month Growth Rate",
                    each
                        if _ = null then
                            null
                        else
                            Number.Round(_, 4),
                    type number
                },
                {
                    "Forecast Weekly Demand - Year 1",
                    each
                        if _ = null then
                            null
                        else
                            Number.Round(_, 2),
                    type number
                },
                {
                    "Forecast Monthly Demand - Year 1",
                    each
                        if _ = null then
                            null
                        else
                            Number.Round(_, 2),
                    type number
                },
                {
                    "Forecast Quarterly Demand - Year 1",
                    each
                        if _ = null then
                            null
                        else
                            Number.Round(_, 2),
                    type number
                },
                {
                    "Q1 Average Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Q2 Average Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Q3 Average Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Q4 Average Demand",
                    each Number.Round(_, 2),
                    type number
                },
                {
                    "Forecast Quarterly 1 Demand - Year 1",
                    each Number.Round(_, 0),
                    type number
                },
                {
                    "Forecast Quarterly 2 Demand - Year 1",
                    each Number.Round(_, 0),
                    type number
                },
                {
                    "Forecast Quarterly 3 Demand - Year 1",
                    each Number.Round(_, 0),
                    type number
                },
                {
                    "Forecast Quarterly 4 Demand - Year 1",
                    each Number.Round(_, 0),
                    type number
                }

            }
        ),

    // -------------------------------------------------------------------------
    // Forecast upload template settings
    // -------------------------------------------------------------------------

    OrganizationCode = "HYD",
    ForecastName = "M92026FC3",
    BucketType = "Weeks",

    // The first weekly date is the Monday after the current date.
    // The output contains 52 weekly records per item.
    ForecastStartDate =
        Date.StartOfWeek(
            Date.AddDays(CurrentDate, 1),
            Day.Monday
        ),

    ForecastWeekCount = 52,

    ForecastEndDate =
        Date.AddDays(
            ForecastStartDate,
            (ForecastWeekCount - 1) * 7
        ),

    // -------------------------------------------------------------------------
    // US holiday functions
    // Update this section if your organization uses a different holiday calendar.
    // -------------------------------------------------------------------------

    NthWeekdayOfMonth =
        (
            YearValue as number,
            MonthValue as number,
            WeekdayValue as number,
            Occurrence as number
        ) as date =>
            let
                FirstOfMonth =
                    #date(
                        YearValue,
                        MonthValue,
                        1
                    ),

                DaysToWeekday =
                    Number.Mod(
                        WeekdayValue
                            - Date.DayOfWeek(
                                FirstOfMonth,
                                Day.Sunday
                            )
                            + 7,
                        7
                    )
            in
                Date.AddDays(
                    FirstOfMonth,
                    DaysToWeekday + ((Occurrence - 1) * 7)
                ),

    LastWeekdayOfMonth =
        (
            YearValue as number,
            MonthValue as number,
            WeekdayValue as number
        ) as date =>
            let
                LastOfMonth =
                    Date.EndOfMonth(
                        #date(
                            YearValue,
                            MonthValue,
                            1
                        )
                    ),

                DaysToSubtract =
                    Number.Mod(
                        Date.DayOfWeek(
                            LastOfMonth,
                            Day.Sunday
                        )
                            - WeekdayValue
                            + 7,
                        7
                    )
            in
                Date.AddDays(
                    LastOfMonth,
                    -DaysToSubtract
                ),

    USHolidays =
        (YearValue as number) as list =>
            {
                // New Year's Day
                #date(YearValue, 1, 1),

                // Martin Luther King Jr. Day
                NthWeekdayOfMonth(
                    YearValue,
                    1,
                    1,
                    3
                ),

                // Presidents' Day
                NthWeekdayOfMonth(
                    YearValue,
                    2,
                    1,
                    3
                ),

                // Memorial Day
                LastWeekdayOfMonth(
                    YearValue,
                    5,
                    1
                ),

                // Juneteenth
                #date(YearValue, 6, 19),

                // Independence Day
                #date(YearValue, 7, 4),

                // Labor Day
                NthWeekdayOfMonth(
                    YearValue,
                    9,
                    1,
                    1
                ),

                // Columbus Day
                NthWeekdayOfMonth(
                    YearValue,
                    10,
                    1,
                    2
                ),

                // Veterans Day
                #date(YearValue, 11, 11),

                // Thanksgiving Day
                NthWeekdayOfMonth(
                    YearValue,
                    11,
                    4,
                    4
                ),

                // Christmas Day
                #date(YearValue, 12, 25)
            },

    HolidayDates =
        List.Combine(
            {
                USHolidays(
                    Date.Year(ForecastStartDate)
                ),
                USHolidays(
                    Date.Year(ForecastEndDate)
                )
            }
        ),

    // -------------------------------------------------------------------------
    // Create the weekly calendar
    // If a Monday is a holiday, move that date to the preceding Monday.
    // -------------------------------------------------------------------------

    WeeklyCalendar =
        List.Transform(
            {
                0 .. ForecastWeekCount - 1
            },
            (WeekIndex) =>
                let
                    StandardMonday =
                        Date.AddDays(
                            ForecastStartDate,
                            WeekIndex * 7
                        ),

                    UploadMonday =
                        if List.Contains(
                            HolidayDates,
                            StandardMonday
                        )
                        then
                            Date.AddDays(
                                StandardMonday,
                                -7
                            )
                        else
                            StandardMonday
                in
                    [
                        StandardMonday = StandardMonday,
                        CalendarDate = UploadMonday
                    ]
        ),

    WeeklyCalendarTable =
        Table.FromRecords(
            WeeklyCalendar,
            type table [
                StandardMonday = date,
                CalendarDate = date
            ]
        ),

    // -------------------------------------------------------------------------
    // Create one upload row for each item and each forecast week
    // -------------------------------------------------------------------------

    ItemUploadTables =
        List.Transform(
            Table.ToRecords(RoundedValues),
            (ItemRecord) =>
                let
                    ItemValue =
                        Text.From(
                            ItemRecord[ITEM_SKEY]
                        ),

                    WeeklyRows =
                        List.Transform(
                            Table.ToRecords(
                                WeeklyCalendarTable
                            ),
                            (CalendarRecord) =>
                                let
                                    CalendarDate =
                                        CalendarRecord[CalendarDate],

                                    QuarterNumber =
                                        Date.QuarterOfYear(
                                            CalendarDate
                                        ),

                                    QuarterStartDate =
                                        #date(
                                            Date.Year(
                                                CalendarDate
                                            ),
                                            ((QuarterNumber - 1) * 3) + 1,
                                            1
                                        ),

                                    QuarterEndDate =
                                        Date.EndOfMonth(
                                            Date.AddMonths(
                                                QuarterStartDate,
                                                2
                                            )
                                        ),

                                    WeeksInQuarter =
                                        Number.RoundUp(
                                            (
                                                Duration.Days(
                                                    QuarterEndDate
                                                        - QuarterStartDate
                                                ) + 1
                                            ) / 7
                                        ),

                                    QuarterlyForecast =
                                        if QuarterNumber = 1 then
                                            ItemRecord[
                                                #"Forecast Quarterly 1 Demand - Year 1"
                                            ]
                                        else if QuarterNumber = 2 then
                                            ItemRecord[
                                                #"Forecast Quarterly 2 Demand - Year 1"
                                            ]
                                        else if QuarterNumber = 3 then
                                            ItemRecord[
                                                #"Forecast Quarterly 3 Demand - Year 1"
                                            ]
                                        else
                                            ItemRecord[
                                                #"Forecast Quarterly 4 Demand - Year 1"
                                            ],

                                    WeeklyQuantity =
                                        if QuarterlyForecast = null then
                                            0
                                        else
                                            Number.Round(
                                                Number.From(
                                                    QuarterlyForecast
                                                )
                                                    / WeeksInQuarter,
                                                0
                                            )
                                in
                                    [
                                        #"Organization Code" =
                                            OrganizationCode,
                                        Forecast =
                                            ForecastName,
                                        Item =
                                            ItemValue,
                                        #"Bucket Type" =
                                            BucketType,
                                        #"Calendar Date" =
                                            CalendarDate,
                                        #"End Date" =
                                            null,
                                        Quantity =
                                            WeeklyQuantity
                                    ]
                        )
                in
                    Table.FromRecords(
                        WeeklyRows
                    )
        ),

    ForecastUploadCombined  =
        Table.Combine(
            ItemUploadTables
        ),

    // Set the output types and column order to match the upload template
    ForecastUploadTyped =
        Table.TransformColumnTypes(
            ForecastUploadCombined,
            {
                {
                    "Organization Code",
                    type text
                },
                {
                    "Forecast",
                    type text
                },
                {
                    "Item",
                    type text
                },
                {
                    "Bucket Type",
                    type text
                },
                {
                    "Calendar Date",
                    type date
                },
                {
                    "End Date",
                    type date
                },
                {
                    "Quantity",
                    Int64.Type
                }
            }
        ),

    ForecastUpload =
        Table.ReorderColumns(
            ForecastUploadTyped,
            {
                "Organization Code",
                "Forecast",
                "Item",
                "Bucket Type",
                "Calendar Date",
                "End Date",
                "Quantity"
            }
        )
in
    ForecastUpload
